/* ResultPolicyTests - user-run SSL tests, locally unexecuted;
/* Install drafts under Calibration and run this test script;
/* No database fixture or writes required.;
:RETURN DoProc("RunTests");

:PROCEDURE RunTests;
	:DECLARE aResults;
	aResults := {};
	AAdd(aResults, DoProc("TestLowerBoundInclusive"));
	AAdd(aResults, DoProc("TestUpperBoundInclusive"));
	AAdd(aResults, DoProc("TestOriginalValueBelowBound"));
	AAdd(aResults, DoProc("TestOriginalValueAboveBound"));
	AAdd(aResults, DoProc("TestNormalizesKey"));
	AAdd(aResults, DoProc("TestUnknownAnalyte"));
	AAdd(aResults, DoProc("TestInvalidAnalyte"));
	AAdd(aResults, DoProc("TestBlankAnalyte"));
	AAdd(aResults, DoProc("TestInvalidValue"));
	AAdd(aResults, DoProc("TestEmptyConfiguration"));
	AAdd(aResults, DoProc("TestRejectsEvaluationAfterBadSetup"));
	AAdd(aResults, DoProc("TestWrongConfigurationType"));
	AAdd(aResults, DoProc("TestWrongLimitRowType"));
	AAdd(aResults, DoProc("TestWrongLimitWidth"));
	AAdd(aResults, DoProc("TestWrongKeyType"));
	AAdd(aResults, DoProc("TestBlankLimitKey"));
	AAdd(aResults, DoProc("TestWrongMinimumType"));
	AAdd(aResults, DoProc("TestWrongMaximumType"));
	AAdd(aResults, DoProc("TestInvertedBounds"));
	AAdd(aResults, DoProc("TestWrongDigitsType"));
	AAdd(aResults, DoProc("TestDigitsOutOfRange"));
	AAdd(aResults, DoProc("TestFractionalDigits"));
	AAdd(aResults, DoProc("TestDuplicateNormalizedKeys"));
	AAdd(aResults, DoProc("TestEmptySetupIsValid"));
	:RETURN DoProc("ReportResults", {aResults});
:ENDPROC;

/* TestLowerBoundInclusive verifies the documented public contract;
:PROCEDURE TestLowerBoundInclusive;
	:DECLARE oPolicy;
	oPolicy := CreateUdObject("Calibration.ResultPolicy", {{{"A", 1, 3, 2}}});
	:RETURN DoProc("CheckEqual", {"LowerBoundInclusive", {.T., {"PASS", 1, 1, 3}},
		oPolicy:Evaluate("A", 1)});
:ENDPROC;

/* TestUpperBoundInclusive verifies the documented public contract;
:PROCEDURE TestUpperBoundInclusive;
	:DECLARE oPolicy;
	oPolicy := CreateUdObject("Calibration.ResultPolicy", {{{"A", 1, 3, 2}}});
	:RETURN DoProc("CheckEqual", {"UpperBoundInclusive", {.T., {"PASS", 3, 1, 3}},
		oPolicy:Evaluate("A", 3)});
:ENDPROC;

/* TestOriginalValueBelowBound verifies the documented public contract;
:PROCEDURE TestOriginalValueBelowBound;
	:DECLARE oPolicy;
	oPolicy := CreateUdObject("Calibration.ResultPolicy", {{{"A", 1, 3, 2}}});
	:RETURN DoProc("CheckEqual", {"OriginalValueBelowBound", {.T., {"LOW", 1, 1, 3}},
		oPolicy:Evaluate("A", 0.999)});
:ENDPROC;

/* TestOriginalValueAboveBound verifies the documented public contract;
:PROCEDURE TestOriginalValueAboveBound;
	:DECLARE oPolicy;
	oPolicy := CreateUdObject("Calibration.ResultPolicy", {{{"A", 1, 3, 2}}});
	:RETURN DoProc("CheckEqual", {"OriginalValueAboveBound", {.T., {"HIGH", 3, 1, 3}},
		oPolicy:Evaluate("A", 3.001)});
:ENDPROC;

