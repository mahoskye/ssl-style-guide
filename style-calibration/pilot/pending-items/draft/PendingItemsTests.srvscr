/* PendingItemsTests - user-run SSL tests, locally unexecuted;
/* Install drafts under Calibration and run this test script;
/* Read-only. Requires only the synthetic rows in FIXTURES.md;
:RETURN DoProc("RunTests");

:PROCEDURE RunTests;
	:DECLARE aResults;
	aResults := {};
	AAdd(aResults, DoProc("TestDefaultStatusOrdersByPriority"));
	AAdd(aResults, DoProc("TestExplicitStatus"));
	AAdd(aResults, DoProc("TestNoMatch"));
	AAdd(aResults, DoProc("TestEmptyOwnerIsExact"));
	:RETURN DoProc("ReportResults", {aResults});
:ENDPROC;

/* TestDefaultStatusOrdersByPriority verifies the documented public contract;
:PROCEDURE TestDefaultStatusOrdersByPriority;
	:RETURN DoProc("CheckEqual", {"Pending order", {{"A1", 5}, {"A2", 5}, {"A3", 1}},
		RunDS("Calibration.PendingItems", {{"sOwner", "A"}})});
:ENDPROC;

/* TestExplicitStatus verifies the documented public contract;
:PROCEDURE TestExplicitStatus;
	:RETURN DoProc("CheckEqual", {"Complete", {{"A5", 4}, {"A6", 4}, {"A7", 4}},
		RunDS("Calibration.PendingItems", {{"sOwner", "A"}, {"sStatus", "COMPLETE"}})});
:ENDPROC;

/* TestNoMatch verifies the documented public contract;
:PROCEDURE TestNoMatch;
	:RETURN DoProc("CheckEqual", {"No match", {},
		RunDS("Calibration.PendingItems", {{"sOwner", "EMPTY"}})});
:ENDPROC;

/* TestEmptyOwnerIsExact verifies the documented public contract;
:PROCEDURE TestEmptyOwnerIsExact;
	:RETURN DoProc("CheckEqual", {"Empty owner", {},
		RunDS("Calibration.PendingItems")});
:ENDPROC;

/* ValuesEqual compares public return values recursively without coercing types;
:PROCEDURE ValuesEqual;
	:PARAMETERS vExpected, vActual;
	:DECLARE sType, i;
	sType := LimsTypeEx(vExpected);
	:IF sType != LimsTypeEx(vActual);
		:RETURN .F.;
	:ENDIF;

	:IF sType == "ARRAY";
		:IF Len(vExpected) != Len(vActual);
			:RETURN .F.;
		:ENDIF;

		:FOR i := 1 :TO Len(vExpected);
			:IF .NOT. DoProc("ValuesEqual", {vExpected[i], vActual[i]});
				:RETURN .F.;
			:ENDIF;
		:NEXT;
		:RETURN .T.;
	:ENDIF;
	:RETURN vExpected == vActual;
:ENDPROC;

/* CheckEqual returns a label/pass pair and logs failed public-contract checks;
:PROCEDURE CheckEqual;
	:PARAMETERS sLabel, vExpected, vActual;
	:DECLARE bPassed;
	bPassed := DoProc("ValuesEqual", {vExpected, vActual});
	:IF .NOT. bPassed;
		ErrorMes("Calibration test", sLabel);
	:ENDIF;
	:RETURN {sLabel, bPassed};
:ENDPROC;

/* ReportResults logs the tally and returns the individual case outcomes;
:PROCEDURE ReportResults;
	:PARAMETERS aResults;
	:DECLARE aResult, nPassed, i;
	nPassed := 0;
	:FOR i := 1 :TO Len(aResults);
		aResult := aResults[i];
		:IF aResult[2];
			nPassed += 1;
		:ENDIF;
	:NEXT;
	InfoMes("Calibration tests", LimsString(nPassed) + " / " + LimsString(Len(aResults)));
	:RETURN aResults;
:ENDPROC;
