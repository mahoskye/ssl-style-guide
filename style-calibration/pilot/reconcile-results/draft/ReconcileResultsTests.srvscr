/* TestSampleGroupingAndTotals verifies its public selection, failure, or count contract;
:PROCEDURE TestSampleGroupingAndTotals;
	:RETURN DoProc("RunCase", {"SampleGroupingAndTotals", {{{"S1", "PH", "MG/L", 1, 3},
		{"S1", "COND", "US", 1, 5}, {"S2", "PH", "MG/L", 1, 3}}, {{"S1", "PH", 2, "MG/L",
		1, "COMPLETE"}, {"S1", "COND", 9, "US", 1, "COMPLETE"}}}, {.T., {{{"S1", "PH",
		"PASS", 2, "MG/L", 1, 1}, {"S1", "COND", "HIGH", 9, "US", 1, 2}, {"S2", "PH",
		"MISSING", NIL, "MG/L", 0, 0}}, {}, {{"S1", 1, 0, 1, 0, 0, 0, 0, 2}, {"S2", 0, 0,
		0, 1, 0, 0, 0, 1}}, {3, 2, 2, 1, 0, 1, 1, 0, 0, 0, 0}}}});
:ENDPROC;

/* RunCase invokes the public script entry point only;
:PROCEDURE RunCase;
	:PARAMETERS sLabel, aArguments, aExpected;
	:DECLARE aActual;
	aActual := ExecFunction("Calibration.ReconcileResults", aArguments);
	:RETURN DoProc("CheckEqual", {sLabel, aExpected, DoProc("Project", {aActual})});
:ENDPROC;

/* Project compares the requested public fields instead of object identity;
:PROCEDURE Project;
	:PARAMETERS aResult;
	:DECLARE oReport;
	:IF .NOT. aResult[1];
		:RETURN aResult;
	:ENDIF;
	oReport := aResult[2];
	:RETURN {.T., {oReport:items, oReport:issues, oReport:samples, oReport:summary}};
:ENDPROC;

/* ValuesEqual compares public return values recursively without coercing types;
:PROCEDURE ValuesEqual;
	:PARAMETERS vExpected, vActual;
	:DECLARE sType, i;
	sType := LimsTypeEx(vExpected);
	:IF sType != LimsTypeEx(vActual);
		:RETURN .F.;
	:ENDIF;

	:IF sType == "ARRAY";
		:IF Len(vExpected) != Len(vActual);
			:RETURN .F.;
		:ENDIF;

		:FOR i := 1 :TO Len(vExpected);
			:IF .NOT. DoProc("ValuesEqual", {vExpected[i], vActual[i]});
				:RETURN .F.;
			:ENDIF;
		:NEXT;
		:RETURN .T.;
	:ENDIF;
	:RETURN vExpected == vActual;
:ENDPROC;

/* CheckEqual returns a label/pass pair and logs failed public-contract checks;
:PROCEDURE CheckEqual;
	:PARAMETERS sLabel, vExpected, vActual;
	:DECLARE bPassed;
	bPassed := DoProc("ValuesEqual", {vExpected, vActual});
	:IF .NOT. bPassed;
		ErrorMes("Calibration test", sLabel);
	:ENDIF;
	:RETURN {sLabel, bPassed};
:ENDPROC;

/* ReportResults logs the tally and returns the individual case outcomes;
:PROCEDURE ReportResults;
	:PARAMETERS aResults;
	:DECLARE aResult, nPassed, i;
	nPassed := 0;
	:FOR i := 1 :TO Len(aResults);
		aResult := aResults[i];
		:IF aResult[2];
			nPassed += 1;
		:ENDIF;
	:NEXT;
	InfoMes("Calibration tests", LimsString(nPassed) + " / " + LimsString(Len(aResults)));
	:RETURN aResults;
:ENDPROC;
