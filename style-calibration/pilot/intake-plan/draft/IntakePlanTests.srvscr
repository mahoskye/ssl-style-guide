/* IntakePlanTests - user-run public-contract tests, locally unexecuted;
/* Install drafts under Calibration and run this test script;
/* Deterministic in-memory fixtures. No database reads or writes;
:RETURN DoProc("RunTests");

:PROCEDURE RunTests;
	:DECLARE aResults;
	aResults := {};
	AAdd(aResults, DoProc("TestAcceptsNormalizedRow"));
	AAdd(aResults, DoProc("TestEmptyInput"));
	AAdd(aResults, DoProc("TestWrongRowsType"));
	AAdd(aResults, DoProc("TestWrongMaterials"));
	AAdd(aResults, DoProc("TestWrongMaterialRow"));
	AAdd(aResults, DoProc("TestWrongMaterialWidth"));
	AAdd(aResults, DoProc("TestWrongMaterialKey"));
	AAdd(aResults, DoProc("TestBlankMaterialKey"));
	AAdd(aResults, DoProc("TestWrongMaterialMinimum"));
	AAdd(aResults, DoProc("TestWrongMaterialMaximum"));
	AAdd(aResults, DoProc("TestInvertedMaterialBounds"));
	AAdd(aResults, DoProc("TestNegativeMaterialMinimum"));
	AAdd(aResults, DoProc("TestDuplicateMaterial"));
	AAdd(aResults, DoProc("TestWrongTestRules"));
	AAdd(aResults, DoProc("TestWrongTestRow"));
	AAdd(aResults, DoProc("TestWrongTestWidth"));
	AAdd(aResults, DoProc("TestWrongTestKey"));
	AAdd(aResults, DoProc("TestBlankTestKey"));
	AAdd(aResults, DoProc("TestWrongTestMaterial"));
	AAdd(aResults, DoProc("TestUnknownTestMaterial"));
	AAdd(aResults, DoProc("TestWrongTestVolume"));
	AAdd(aResults, DoProc("TestNegativeTestVolume"));
	AAdd(aResults, DoProc("TestDuplicateTestRule"));
	AAdd(aResults, DoProc("TestWrongExistingRecords"));
	AAdd(aResults, DoProc("TestWrongExistingRow"));
	AAdd(aResults, DoProc("TestWrongExistingWidth"));
	AAdd(aResults, DoProc("TestWrongExistingSample"));
	AAdd(aResults, DoProc("TestWrongExistingContainer"));
	AAdd(aResults, DoProc("TestBlankExistingKey"));
	AAdd(aResults, DoProc("TestWrongRowType"));
	AAdd(aResults, DoProc("TestWrongRowWidth"));
	AAdd(aResults, DoProc("TestWrongRowKey"));
	AAdd(aResults, DoProc("TestBlankRowKey"));
	AAdd(aResults, DoProc("TestWrongOwner"));
	AAdd(aResults, DoProc("TestBlankOwner"));
	AAdd(aResults, DoProc("TestWrongVolume"));
	AAdd(aResults, DoProc("TestWrongPriority"));
	AAdd(aResults, DoProc("TestPriorityOutOfRange"));
	AAdd(aResults, DoProc("TestFractionalPriority"));
	AAdd(aResults, DoProc("TestUnknownMaterial"));
	AAdd(aResults, DoProc("TestVolumeOutOfRange"));
	AAdd(aResults, DoProc("TestWrongTestList"));
	AAdd(aResults, DoProc("TestEmptyTestList"));
	AAdd(aResults, DoProc("TestWrongRequestedTest"));
	AAdd(aResults, DoProc("TestBlankRequestedTest"));
	AAdd(aResults, DoProc("TestDuplicateRequestedTest"));
	AAdd(aResults, DoProc("TestUnknownRequestedTest"));
	AAdd(aResults, DoProc("TestIncompatibleTest"));
	AAdd(aResults, DoProc("TestDemandExceedsVolume"));
	AAdd(aResults, DoProc("TestExistingSample"));
	AAdd(aResults, DoProc("TestExistingContainer"));
	AAdd(aResults, DoProc("TestDuplicateAcceptedSample"));
	AAdd(aResults, DoProc("TestContainerMaterialConflict"));
	AAdd(aResults, DoProc("TestContainerVolumeConflict"));
	AAdd(aResults, DoProc("TestSharedContainerDemand"));
	AAdd(aResults, DoProc("TestRejectedRowDoesNotReserveKeys"));
	AAdd(aResults, DoProc("TestPrefixDistinctTests"));
	:RETURN DoProc("ReportResults", {aResults});
:ENDPROC;

/* TestAcceptsNormalizedRow checks the public outcome for its stated fixture;
:PROCEDURE TestAcceptsNormalizedRow;
	:RETURN DoProc("RunCase", {"AcceptsNormalizedRow", {{{" s1 ", "c1", "water", 10, 5,
		"team", {"ph"}}}, {{"WATER", 1, 20}, {"SOLID", 1, 20}}, {{"PH", "WATER", 2},
		{"COND", "WATER", 1}, {"MASS", "SOLID", 3}, {"PHA", "WATER", 1}}, {}}, {.T., {{{1,
		"S1", "C1", "WATER", 10, 5, "TEAM", {"PH"}}}, {}, {{"C1", "WATER", 10, 2,
		{"S1"}}}, {{"TEAM", 1, 1, {"S1"}}}, {1, 1, 0, 1, 1}}}});
:ENDPROC;

/* TestEmptyInput checks the public outcome for its stated fixture;
:PROCEDURE TestEmptyInput;
	:RETURN DoProc("RunCase", {"EmptyInput", {{}, {{"WATER", 1, 20}, {"SOLID", 1, 20}},
